  [SHEETS.STUDENTS]: ['Student ID','Full Name','Phone Clean','Email','Gender','Source','Registration Date','Preferred Mode','Current Module','Status','First Attendance','Last Attendance','Module 1 Count','Module 2 Count','Attendance Count','Eligible To Graduate','Graduated','Updated At'],
  [SHEETS.ATTENDANCE]: ['Attendance ID','Timestamp','Class Date','Full Name','Phone Clean','Module','Attendance Mode','Registration Status','Is First Attendance','Recorded By','Source','Notes'],
  [SHEETS.ADMIN_ATTENDANCE]: ['ID','Timestamp','Class Date','Admin Name','Attendance Mode','Status','Recorded By','Notes'],
  [SHEETS.TASKS]: ['Task ID','Task Date','Task Title','Task Description','Assigned Admin','Priority','Due Date','Status','Completed Date','Score','Proof Link','Reviewer Comment','Created By','Updated At'],
  [SHEETS.FACULTY]: ['Class Date','Module','Faculty Name','Topic','Class Time','Venue','Mode','Status','Notes','Updated At','Updated By'],
  [SHEETS.EMAIL_QUEUE]: ['Email ID','Type','Recipient Name','Phone Clean','Email','Subject','Body','Status','Queued At','Sent At','Retry Count','Last Error','Queued By'],
  [SHEETS.GRADUATES]: ['Graduate ID','Graduation Date','Full Name','Phone Clean','Module 1 Count','Module 2 Count','Approved By','Notes'],
