/**
 * NPOC Operations Hub Backend Engine — V1.1 Backend Production Draft
 * Google Apps Script Web App backend for the NPOC Operations Hub front-end.
 *
 * Deploy as Web App:
 *  - Execute as: Me
 *  - Who has access: Anyone within your organisation OR Anyone with link (if needed)
 *  - Set Script Properties:
 *      API_KEY = a long random string
 *      FRONTEND_ORIGIN = your GitHub Pages/Netlify URL, optional
 *      FROM_NAME = Rock Foundation School
 *
 * Core production safeguards:
 *  - API key verification
 *  - Google account email capture where available
 *  - Role validation from Users sheet
 *  - LockService around writes
 *  - Audit logs for every mutation
 *  - Duplicate prevention by cleaned 234 phone number
 *  - Attendance validation and graduation eligibility
 *  - Queued Gmail sending with status, timestamps, and retry tracking
 */

const VERSION = '1.1.0-backend';
const TZ = 'Africa/Lagos';

const SHEETS = {
  SETTINGS: 'Settings',
  USERS: 'Users',
  ADMINS: 'Admins',
  CALL_LIST: 'Call_List',
  STUDENTS: 'Students',
  ATTENDANCE: 'Attendance',
  ADMIN_ATTENDANCE: 'Admin_Attendance',
  TASKS: 'Admin_Tasks',
  FACULTY: 'Faculty_Schedule',
  EMAIL_QUEUE: 'Email_Queue',
  GRADUATES: 'Graduates',
  REPORTS: 'Monthly_Reports',
  AUDIT: 'Audit_Log',
  SESSIONS: 'Sessions'
};

const HEADERS = {
  [SHEETS.SETTINGS]: ['Key','Value','Notes','Updated At'],
